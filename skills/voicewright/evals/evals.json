{
  "skill": "voicewright",
  "_format": "evergreen-test. Action cases and their folders are written by evals/build_cases.py; trigger and decoy folders by evergreen.py eval-export --out evals/cases.",
  "evals": [
    {
      "id": "trigger-1",
      "kind": "trigger",
      "prompt": "My RPG has ten NPCs and every TTS voice I try sounds like the same two people. Help me fix the cast.",
      "expectations": [
        "the voicewright skill is invoked"
      ],
      "runs": 3
    },
    {
      "id": "trigger-2",
      "kind": "trigger",
      "prompt": "Design a narrator voice for my kids' story and keep it the same for every chapter.",
      "expectations": [
        "the voicewright skill is invoked"
      ],
      "runs": 3
    },
    {
      "id": "trigger-3",
      "kind": "trigger",
      "prompt": "Which local TTS should I use for game dialogue? It has to be commercial-safe.",
      "expectations": [
        "the voicewright skill is invoked"
      ],
      "runs": 3
    },
    {
      "id": "decoy-1",
      "kind": "decoy",
      "prompt": "Write a battle theme with a choir for my game.",
      "expectations": [
        "voicewright is not invoked"
      ],
      "runs": 3
    },
    {
      "id": "decoy-2",
      "kind": "decoy",
      "prompt": "Transcribe this meeting recording to text.",
      "expectations": [
        "voicewright is not invoked"
      ],
      "runs": 3
