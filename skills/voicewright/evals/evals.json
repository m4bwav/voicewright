      "evidence": {
        "all": [
          {
            "type": "file",
            "path": "old/voices.json",
            "match": "\"schema\":\\s*1"
          },
          {
            "type": "file",
            "path": "old/voices.json",
            "match": "\"character\""
          }
        ]
      },
      "fixture": "rebuild"
